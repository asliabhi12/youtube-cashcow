# YouTube CashCow Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application Settings
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Future placeholder settings (Phase 2+)
# YT_DLP_COOKIES_PATH=
# FFMPEG_PATH=
# YOUTUBE_API_KEY=

# AI metadata generation (Google Gemini)
# Required for automatic AI metadata generation. Leave unset to run the app
# without metadata generation.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Single-User Admin Authentication
CASHCOW_ADMIN_USER=admin
CASHCOW_ADMIN_PASSWORD=admin
# CASHCOW_SECRET_KEY=change_this_to_a_random_secret_string

