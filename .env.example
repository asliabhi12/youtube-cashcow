# YouTube CashCow Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application Settings
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Network & Host Configuration
# URL of the Next.js frontend (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000
# Base URL of the FastAPI backend API server
BACKEND_URL=http://localhost:8000
# Optional explicit API URL for Next.js frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google OAuth & YouTube Publishing
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# AI Metadata Generation Settings
METADATA_PROVIDER=openrouter
OPENROUTER_API_KEY=
GEMINI_API_KEY=
